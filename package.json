{
  "name": "forms-pwa",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm -w packages/api run dev",
    "dev:web": "npm -w packages/web run dev",
    "build": "npm -w packages/config run build && npm -w packages/api run build && npm -w packages/web run build",
    "db:generate": "npm -w packages/api run db:generate",
    "db:migrate": "npm -w packages/api run db:migrate",
    "lint": "npm -w packages/api run lint && npm -w packages/web run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
